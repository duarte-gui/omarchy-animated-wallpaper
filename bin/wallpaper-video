#!/bin/bash
# wallpaper-video — the engine behind the Animated Wallpaper bar widget.
# Plays the videos in a folder as the desktop wallpaper with mpvpaper.
#
# The bar widget owns the settings and calls this script; it can also be run by hand:
#
#   wallpaper-video start <folder> [--shuffle] [--advance manual|end] [--start-video <file>]
#                                  [--pause-hidden] [--output <name>] [--mpv-options "<opts>"]
#   wallpaper-video stop
#   wallpaper-video next          — skip to the next video; prints its path
#   wallpaper-video status        — one line of JSON: {"running":…,"folder":…,"videos":…,"video":…}
#   wallpaper-video count <folder>
#
# --advance manual (the default) loops the current video until `next`;
# --advance end moves on whenever a video finishes.
#
# mpvpaper runs in its own session (setsid), so restarting or hot-reloading the
# Omarchy shell does not take the wallpaper down with it.

set -uo pipefail

# WALLPAPER_VIDEO_STATE_DIR lets a second instance run beside the real one, for testing.
STATE_DIR="${WALLPAPER_VIDEO_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/wallpaper-video}"
PID_FILE="$STATE_DIR/pid"
FOLDER_FILE="$STATE_DIR/folder"
PLAYLIST="$STATE_DIR/playlist.m3u"
SOCKET="$STATE_DIR/mpv.sock"
LOG_FILE="$STATE_DIR/mpvpaper.log"

# What counts as a video in the folder. gif is an image to mpv, but it is kept
# here so animated gifs work as they did upstream.
VIDEO_EXTS="3g2 3gp avi flv gif m2ts m4v mkv mov mp4 mpeg mpg ogv ts webm wmv"

mkdir -p "$STATE_DIR"

die() {
  echo "wallpaper-video: $*" >&2
  exit 1
}

expand_path() {
  local path="$1"
  [[ $path == "~" || $path == "~/"* ]] && path="$HOME${path:1}"
  printf '%s\n' "${path%/}"
}

json_string() {
  # Paths may contain quotes or backslashes; let python do the escaping.
  python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

# The folder's videos, one absolute path per line, in natural name order.
list_videos() {
  local folder="$1" file ext
  [[ -d $folder ]] || return 0
  shopt -s nullglob
  for file in "$folder"/*; do
    [[ -f $file ]] || continue
    ext="${file##*.}"
    [[ " $VIDEO_EXTS " == *" ${ext,,} "* ]] && printf '%s\n' "$file"
  done | sort -V
  shopt -u nullglob
}

count_videos() {
  list_videos "$1" | grep -c . || true
}

running_pid() {
  local pid
  [[ -f $PID_FILE ]] || return 1
  pid="$(<"$PID_FILE")"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  # Guard against a reused pid: it must still be our mpvpaper.
  [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == mpvpaper ]] || return 1
  echo "$pid"
}

# Talk to mpv over its IPC socket. `mpv_ipc path` prints the current file;
# `mpv_ipc next` skips ahead and prints the file it landed on.
mpv_ipc() {
  python3 -I - "$SOCKET" "$1" <<'EOF'
import json, socket, sys, time

sock = socket.socket(socket.AF_UNIX)
sock.settimeout(2)
sock.connect(sys.argv[1])
reader = sock.makefile("rb")
request_id = 0

def call(*command):
    global request_id
    request_id += 1
    sock.sendall((json.dumps({"command": list(command), "request_id": request_id}) + "\n").encode())
    while True:
        reply = json.loads(reader.readline())
        if reply.get("request_id") == request_id:
            return reply.get("data")

before = call("get_property", "path")
if sys.argv[2] == "next":
    call("playlist-next", "force")
    # The new file loads asynchronously; wait for path to move on. A one-video
    # folder never changes, so give up after a second and report it as is.
    for _ in range(20):
        time.sleep(0.05)
        now = call("get_property", "path")
        if now and now != before:
            before = now
            break
print(before or "")
EOF
}

stop() {
  local pid
  if pid="$(running_pid)"; then
    kill "$pid" 2>/dev/null
    for _ in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$FOLDER_FILE" "$SOCKET"
}

start() {
  local folder="" shuffle=no advance=manual start_video="" pause_hidden=no output="*" extra=""

  while (($# > 0)); do
    case "$1" in
    --shuffle) shuffle=yes ;;
    --advance)
      advance="${2:?--advance needs manual or end}"
      [[ $advance == manual || $advance == end ]] || die "--advance must be manual or end"
      shift
      ;;
    --start-video) start_video="${2-}"; shift ;;
    --pause-hidden) pause_hidden=yes ;;
    --output) output="${2:?--output needs a monitor name}"; shift ;;
    --mpv-options) extra="${2-}"; shift ;;
    -*) die "unknown option '$1'" ;;
    *) folder="$1" ;;
    esac
    shift
  done

  [[ -n $folder ]] || die "no folder given"
  folder="$(expand_path "$folder")"
  [[ -d $folder ]] || die "folder not found: $folder"

  local videos
  mapfile -t videos < <(list_videos "$folder")
  ((${#videos[@]} > 0)) || die "no videos in $folder"

  command -v mpvpaper >/dev/null 2>&1 || die "mpvpaper is not installed (yay -S mpvpaper)"

  # The playlist is built here rather than handing mpv the folder, so it can
  # start on a given video: the one that was playing before a logout or an
  # off/on. Shuffling happens here too, which keeps that video first.
  [[ $shuffle == yes ]] && mapfile -t videos < <(printf '%s\n' "${videos[@]}" | shuf)

  local first=0 i
  if [[ -n $start_video ]]; then
    start_video="$(expand_path "$start_video")"
    for i in "${!videos[@]}"; do
      [[ ${videos[$i]} == "$start_video" ]] && { first=$i; break; }
    done
  fi

  stop

  {
    echo "#EXTM3U"
    printf '%s\n' "${videos[@]:first}" "${videos[@]:0:first}"
  } >"$PLAYLIST"

  local opts="no-audio loop-playlist=inf hwdec=auto input-ipc-server=$SOCKET"
  # loop-file keeps the current video going forever; playlist-next still moves on.
  [[ $advance == manual ]] && opts+=" loop-file=inf"
  [[ -n $extra ]] && opts+=" $extra"

  local args=(-l bottom -o "$opts")
  [[ $pause_hidden == yes ]] && args=(-p "${args[@]}")

  # The bottom layer sits above omarchy-background and below every window, so
  # a shell restart that recreates the static background cannot cover the video.
  # mpvpaper leaves its input region empty, so desktop clicks still reach the shell.
  setsid mpvpaper "${args[@]}" "$output" "$PLAYLIST" >"$LOG_FILE" 2>&1 </dev/null &
  local pid=$!
  echo "$pid" >"$PID_FILE"
  printf '%s\n' "$folder" >"$FOLDER_FILE"

  # mpvpaper dies right away on a bad output name or a broken mpv option; say so
  # instead of reporting a wallpaper that is not there.
  sleep 0.5
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE" "$FOLDER_FILE"
    die "mpvpaper exited at start: $(tail -n 3 "$LOG_FILE" | tr '\n' ' ')"
  fi
}

next() {
  running_pid >/dev/null || die "not running"
  mpv_ipc next || die "could not reach mpv"
}

status() {
  local running=false folder="" videos=0 video=""
  if running_pid >/dev/null; then
    running=true
    folder="$(cat "$FOLDER_FILE" 2>/dev/null)"
    videos="$(count_videos "$folder")"
    video="$(mpv_ipc path 2>/dev/null)"
  fi
  echo "{\"running\":$running,\"folder\":$(json_string "$folder"),\"videos\":$videos,\"video\":$(json_string "$video")}"
}

case "${1:-}" in
start) shift; start "$@" ;;
stop) stop ;;
next) next ;;
status) status ;;
count) count_videos "$(expand_path "${2:?count needs a folder}")" ;;
*)
  sed -n '5,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 1
  ;;
esac
